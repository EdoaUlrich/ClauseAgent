# Clé d'API Anthropic (obligatoire pour les appels au modèle)
ANTHROPIC_API_KEY=

# Modèle utilisé par l'agent (défaut : claude-opus-5)
CLAUSEAGENT_MODELE=claude-opus-5

# Niveau d'effort du modèle : low | medium | high | xhigh | max
CLAUSEAGENT_EFFORT=high

# Anonymisation des données avant envoi au modèle (1 = activée, 0 = désactivée)
CLAUSEAGENT_ANONYMISATION=1

# Nombre maximal d'itérations de la boucle agentique
CLAUSEAGENT_MAX_ITERATIONS=24

# Nombre maximal de jetons produits par réponse
CLAUSEAGENT_MAX_TOKENS=16000

# Répertoire de sortie des tableaux de suivi
CLAUSEAGENT_SORTIES=sorties
