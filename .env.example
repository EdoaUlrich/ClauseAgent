# Cle d'API Anthropic (obligatoire pour les appels au modele)
ANTHROPIC_API_KEY=

# Modele utilise par l'agent (defaut : claude-opus-5)
CLAUSEAGENT_MODELE=claude-opus-5

# Niveau d'effort du modele : low | medium | high | xhigh | max
CLAUSEAGENT_EFFORT=high

# Anonymisation des donnees avant envoi au modele (1 = active, 0 = desactive)
CLAUSEAGENT_ANONYMISATION=1

# Nombre maximal d'iterations de la boucle agentique
CLAUSEAGENT_MAX_ITERATIONS=24

# Repertoire de sortie des tableaux de suivi
CLAUSEAGENT_SORTIES=sorties
